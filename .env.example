# Copy to .env.local and fill in from the Supabase dashboard.
# .env* is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database
#
# Two URLs, deliberately. Using the wrong one fails in ways that are hard to
# diagnose — see the note in src/db/index.ts.
# ---------------------------------------------------------------------------

# Transaction pooler (port 6543). Used by the app at runtime.
# Dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct session connection (port 5432). Used by migrations and any DDL.
# Dashboard → Project Settings → Database → Connection string → Session pooler
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Server-only. Bypasses row-level security — never expose to the browser, never
# prefix with NEXT_PUBLIC_. Note that it does NOT bypass our append-only
# triggers, which is the point of enforcing invariants there rather than in RLS.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---------------------------------------------------------------------------
# SMS — phone OTP (AD-04). Not yet wired.
# ---------------------------------------------------------------------------

# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID=""

# ---------------------------------------------------------------------------
# Development sign-in bypass
#
# Lets the OTP screen accept a fixed code while no SMS provider is configured
# (enabling phone auth in India also needs DLT registration — days to weeks).
#
# It creates a real auth.users row, so every foreign key, the advisor record and
# the registration gate behave exactly as in production. What it does not create
# is a Supabase JWT, so the session is a signed cookie owned by
# src/server/auth/dev-session.ts.
#
# Refuses to run unless NODE_ENV !== "production", or the override below is set.
# Delete the module and these variables once SMS is configured.
# ---------------------------------------------------------------------------

DEV_AUTH_BYPASS=true
DEV_OTP_CODE=1111
# openssl rand -hex 32
DEV_AUTH_SECRET=

# Lets the bypass run in a production build — needed on the Netlify deploy,
# whose Supabase project has no SMS provider either, so without it there is no
# way to sign in at all.
#
# This opens the front door: anyone who finds the URL signs in as any phone
# number using DEV_OTP_CODE. Set it only on a throwaway demo deployment with no
# real data behind it. Leave it unset locally — NODE_ENV already allows the
# bypass there — and never set it on anything a real user touches.
# DEV_AUTH_ALLOW_IN_PRODUCTION=true

# ---------------------------------------------------------------------------
# Market data — Upstox
#
# The only vendor the engine reads OHLCV from. A free Analytics Token is
# read-only, valid one year, needs no daily regeneration and carries no IP
# whitelist, which is what makes the unattended evening job possible at all.
# Generate one from the developer dashboard under Apps -> Analytics.
#
# UPSTOX_TOKEN_EXPIRES_ON is the token's own expiry date, recorded by hand
# because the API does not report it. `npm run check-forward-tests` warns at 60
# days and fails at 14. Expiry is the highest-consequence silent failure in the
# pipeline: the loader starts failing, the advancer finds no new bars, and every
# running forward test freezes in place while still reading as RUNNING.
# ---------------------------------------------------------------------------

UPSTOX_API_TOKEN=
UPSTOX_TOKEN_EXPIRES_ON=2027-08-21

# ---------------------------------------------------------------------------
# AI provider (AD-11 / W15-01)
# ---------------------------------------------------------------------------
# Unset, the app falls back to the stub: `metadata.live` is false and any screen
# rendering the output can say no model was involved. Set, it is the one seam
# `resolveProvider()` reads — nothing else in the codebase reads a key.
#
# The model MUST support BOTH `tools` and `structured_outputs`. Only six of
# OpenRouter's twenty-one free models do; check `supported_parameters` at
# https://openrouter.ai/api/v1/models before changing this. Notably
# `nemotron-3-ultra-550b-a55b:free` supports tools but NOT structured outputs,
# so it fails every call this provider makes.
#
# ⚠️ FREE TIER IS FOR DEVELOPMENT ONLY. Free capacity is paid for with data:
# prompts may be logged and trained on, and `input_snapshot` carries the user's
# strategy logic — the one thing CLAUDE.md §8.5 makes private. Before real
# users, drop the `:free` suffix to reach the paid variant of the same model.
# That is the entire production change.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
